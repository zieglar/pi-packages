{
  "name": "@zieglar/pi-chat-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "Generic chat-exchange protocol with pure core rules, a private durable SQLite foundation, and a minimal MCP ping smoke.",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:storage": "vitest run test/storage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check": "node scripts/check-contract.mjs",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
