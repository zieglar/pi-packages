{
  "name": "@zieglar/pi-chat-exchange",
  "version": "0.1.1",
  "private": true,
  "description": "Generic chat-exchange protocol with pure core rules, a private durable SQLite foundation, and a minimal MCP ping smoke.",
  "type": "module",
  "engines": {
    "node": "24.21.0 || 24.22.1"
  },
  "scripts": {
    "test": "CE_DEFAULT_CLIENT_GUARD=1 vitest run --exclude test/tunnel/real-client-compat.test.ts --exclude test/tunnel/offline.integration.test.ts",
    "test:installed-client": "vitest run test/tunnel/real-client-compat.test.ts test/tunnel/offline.integration.test.ts",
    "test:storage": "vitest run test/storage",
    "test:plugin-package": "CE_PLUGIN_PACKAGE_TEST=1 vitest run test/plugin/local-plugin-package.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "package:desktop-plugin": "node scripts/package-local-plugin.mjs",
    "recover:ownership": "node scripts/recover-stale-ownership.mjs",
    "reconcile:session-mutex": "node scripts/reconcile-session-process-mutex.mjs",
    "check": "node scripts/check-contract.mjs",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run build && pnpm test && pnpm run test:plugin-package"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@narumitw/pi-tui-kit": "0.66.0",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pi": {
    "extensions": [
      "./pi-extension/index.ts"
    ]
  }
}
