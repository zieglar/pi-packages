# Wayforge repository-local npm configuration.
# The approved Phase 1A plan pins @earendil-works/pi-coding-agent@1.0.2, which was
# published the same day this repo was bootstrapped. The user's global ~/.npmrc sets
# min-release-age=7, which would refuse that pinned version. This project-local
# override relaxes the check for THIS REPOSITORY ONLY; global npm configuration and
# production Pi configuration are deliberately left untouched.
min-release-age=0
