{
  "name": "wayforge",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic agent orchestration kernel (Phase 1A): invocation, policy, runtime ownership, recovery, health, and durable-state contracts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:alpha0": "node scripts/check-alpha0.mjs",
    "check:alpha1": "node scripts/check-alpha1.mjs",
    "verify": "pnpm run check:architecture && pnpm test && pnpm run typecheck && pnpm run build",
    "verify:alpha0": "pnpm run verify && pnpm run check:alpha0",
    "pi:version": "node -p \"JSON.parse(require('fs').readFileSync('node_modules/@earendil-works/pi-coding-agent/package.json','utf8')).version\"",
    "check:baseline": "node scripts/check-baseline.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@sinclair/typebox": "0.34.52",
    "pi-subagents": "0.70.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "pi-subagents": {
      "undici": "8.10.2"
    }
  }
}
